{
  "name": "astro-eval",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --force --open",
    "build": "rimraf dist && astro build",
    "preview": "pnpm build && astro preview --open"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "html.format.wrapAttributes": "force",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "endOfLine": "lf"
  },
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.6.0",
    "@tailwindcss/vite": "^4.1.14",
    "astro": "^5.12.0",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "^4.1.2",
    "@tailwindcss/typography": "^0.5.19",
    "astro-rehype-relative-markdown-links": "^0.18.1",
    "cross-env": "^7.0.3",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^6.0.1",
    "ts-regex-builder": "^1.8.2"
  }
}