---
import '../styles/global.css'
import { SITE } from '../config'
import ThemeSwitcher from '../components/ThemeSwitcher.astro'
import ThemeSwitcherCursor from '../components/ThemeSwitcherCursor.astro'

interface Props {
  title?: string
  description?: string
  structuredData?: object
}

const {
  title = SITE.title,
  description = SITE.description,
  structuredData
} = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---
<!DOCTYPE html>
<html lang="en" class="theme-emerald">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="article" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}

  <base href={import.meta.env.BASE_URL} />
  <link rel="icon" href="favicon.svg" sizes="32x32" />

  <style>
    @font-face {
      font-family: 'JetBrains Mono';
      src: url('/fonts/jetbrains-mono-400.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    .mono {
      font-family: 'JetBrains Mono', monospace;
    }
    .cursor {
      width: 0.5rem;
      height: 1rem;
      animation: blink-cursor 1.5s infinite steps(2, start);
    }
    @keyframes blink-cursor {
      0%, 70% { opacity: 1; }
      80%, 100% { opacity: 0; }
    }
  </style>
</head>

<body class="mono bg-gray-900 text-gray-300 flex flex-col min-h-screen">
<header class="w-full max-w-2xl mx-auto p-3 flex items-center justify-between border-b border-gray-700">
  <a href="/" class="text-lg text-accent-400 hover:text-accent-300 flex items-center gap-2">
    <span>Jigar Gosar</span>
    <span class="flex gap-1.5 items-end">
      {[...Array(4)].map(() => (
        <span class="w-2 h-6 bg-accent-600 inline-block" style="transform: skewX(-12deg);"></span>
      ))}
    </span>
  </a>
  <nav class="flex items-center gap-4">
    <a href="/resume/" class="text-sm text-accent-400 underline decoration-accent-950 hover:decoration-accent-700" style="text-underline-offset: 0.2em; text-decoration-thickness: 0.2em;">Resume</a>
    <ThemeSwitcher />
  </nav>
</header>

<main class="w-full max-w-prose mx-auto px-3 py-8 flex-grow">
  <slot />
</main>

<footer class="w-full max-w-2xl mx-auto p-4 border-t border-gray-700 flex flex-col items-center">
  <p class="text-xs text-gray-400">Powered by Astro & Markdown</p>
  <ThemeSwitcherCursor />
</footer>

<script>
  import '../scripts/copy-code.js'
</script>
</body>
</html>
