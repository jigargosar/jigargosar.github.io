---
import '../styles/global.css'
import { SITE, DEFAULT_THEME } from '../config'
import ThemeSwitcher from '../components/ThemeSwitcher.astro'
import ThemeSwitcherCursor from '../components/ThemeSwitcherCursor.astro'
import Link from '../components/Link.astro'
import HeadCommon from '../components/HeadCommon.astro'

interface Props {
  title?: string
  description?: string
  structuredData?: object
}

const {
  title = SITE.title,
  description = SITE.description,
  structuredData
} = Astro.props

const navLinks = [
  { title: 'About', href: '/resume/' },
  { title: 'Projects', href: 'https://github.com/jigargosar' },
  { title: 'Resume', href: '/resume/' }
]

const skewedBar = {
  class: 'w-2 h-6 bg-accent-600 inline-block',
  style: 'transform: skewX(-12deg);'
}
---
<!DOCTYPE html>
<html lang="en" class={DEFAULT_THEME}>
<head>
  <HeadCommon title={title} description={description} structuredData={structuredData} />

  <style>
    @font-face {
      font-family: 'JetBrains Mono';
      src: url('/fonts/jetbrains-mono-400.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    .mono {
      font-family: 'JetBrains Mono', monospace;
    }
    .cursor {
      width: 0.5rem;
      height: 1rem;
      animation: blink-cursor 1.5s infinite steps(2, start);
    }
    @keyframes blink-cursor {
      0%, 70% { opacity: 1; }
      80%, 100% { opacity: 0; }
    }
  </style>
</head>

<body class="mono bg-gray-900 text-gray-300 flex flex-col min-h-screen">
<header class="w-full max-w-2xl mx-auto p-3 flex items-center justify-between gap-4 border-b border-gray-700">
  <a href="/" class="text-lg text-accent-400 hover:text-accent-300 flex items-center gap-2 whitespace-nowrap">
    <span>Jigar Gosar</span>
    <span class="flex gap-1.5 items-end">
      {[...Array(4)].map(() => (
        <span class={skewedBar.class} style={skewedBar.style}></span>
      ))}
    </span>
  </a>
  <div class="flex items-center gap-4">
    <nav class="flex flex-wrap justify-end items-center gap-x-4 gap-y-2">
      {navLinks.map(link => (
        <div class="flex items-center gap-4">
          <Link href={link.href}>{link.title}</Link>
          <span class={skewedBar.class} style={skewedBar.style}></span>
        </div>
      ))}
    </nav>
    <ThemeSwitcher />
  </div>
</header>

<main class="w-full px-3 py-8 flex-grow">
  <div class="max-w-prose mx-auto">
    <slot />
  </div>
</main>

<footer class="w-full max-w-2xl mx-auto p-4 border-t border-gray-700 flex flex-col items-center gap-2">
  <p class="text-xs text-gray-400">Powered by Astro & Markdown</p>
  <ThemeSwitcherCursor />
</footer>

<script>
  import '../scripts/copy-code.js'
</script>
</body>
</html>
