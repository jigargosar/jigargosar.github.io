---
import '../styles/global.css'
import { SITE } from '../config'
import Link from '../components/Link.astro'
import HeadCommon from '../components/HeadCommon.astro'

interface Props {
  title?: string
  description?: string
  structuredData?: object
}

const {
  title = SITE.title,
  description = SITE.description,
  structuredData
} = Astro.props

const navLinks = [
  { title: 'About', href: '/resume/' },
  { title: 'Projects', href: 'https://github.com/jigargosar' },
  { title: 'Resume', href: '/resume/' }
]
---
<!DOCTYPE html>
<html lang="en">
<head>
  <HeadCommon title={title} description={description} structuredData={structuredData} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    .cursor {
      width: 7px;
      height: 12px;
      animation: blink-cursor 1.5s infinite steps(2, start);
    }
    @keyframes blink-cursor {
      0%, 70% { opacity: 1; }
      80%, 100% { opacity: 0; }
    }
  </style>
</head>

<body class="font-serif bg-bg text-w60 flex flex-col min-h-screen font-light antialiased" style="font-size: 17px; line-height: 1.8;">

<div class="w-full max-w-[820px] mx-auto px-10">
  <header class="py-7 border-b border-w08 relative overflow-hidden">
    <span class="absolute left-0 top-1/2 -translate-y-1/2 font-mono select-none pointer-events-none" style="font-size: 120px; line-height: 1; color: hsl(0 0% 100% / 0.10);">λ</span>
    <div class="flex items-center justify-between relative">
      <a href="/" class="font-serif font-light text-2xl text-w75 no-underline" style="letter-spacing: 0.5px; margin-left: 56px;">
        Jigar Gosar
      </a>
      <nav class="flex gap-8">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="font-mono text-xs text-w30 no-underline hover:text-w60"
            style="letter-spacing: 0.5px; transition: color 150ms ease;"
          >
            {link.title}
          </a>
        ))}
      </nav>
    </div>
  </header>
</div>

<main class="w-full flex-grow">
  <div class="max-w-[820px] mx-auto px-10 py-12">
    <slot />
  </div>
</main>

<div class="w-full max-w-[820px] mx-auto px-10">
  <footer class="border-t border-w08 py-7 flex justify-between items-center font-mono text-xs text-w18" style="letter-spacing: 0.5px;">
    <span class="flex items-center gap-2">
      <span class="cursor bg-w18 inline-block"></span>
      <span>Jigar Gosar</span>
    </span>
    <span>2026</span>
  </footer>
</div>

<script>
  import '../scripts/copy-code.js'
</script>
</body>
</html>
