---
import '../styles/global.css'
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>jigar@blog:~$</title>


  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100;200&display=block"
    rel="stylesheet"
  />

  <base href={import.meta.env.BASE_URL} />
  <link rel="icon" href="favicon.svg" sizes="32x32" />

  <style>
    .mono {
      font-family: 'JetBrains Mono', monospace;
    }
    .cursor {
      width: 0.5rem;
      height: 1rem;
      animation: blink-cursor 1.5s infinite steps(2, start);
    }
    @keyframes blink-cursor {
      0%, 70% { opacity: 1; }
      80%, 100% { opacity: 0; }
    }
  </style>
</head>

<body class="mono bg-gray-900 text-gray-300 flex flex-col min-h-screen">
<header class="w-full max-w-2xl mx-auto p-3 flex items-center border-b border-gray-700">
  <!--<span class="text-lg text-cyan-400">jigar.gosar@blog:~$</span>-->
  <a href="/" class="text-lg text-cyan-400 hover:text-cyan-300">Jigar Gosar</a>
</header>

<main class="w-full max-w-prose mx-auto px-3 py-8 flex-grow">
  <slot />
</main>

<footer class="w-full max-w-2xl mx-auto p-3 border-t border-gray-700 flex flex-col items-center">
  <p class="text-xs text-gray-400">Powered by Astro & Markdown</p>
  <span class="cursor inline-block bg-cyan-400"></span>
</footer>

<script>
  import '../scripts/copy-code.js'
</script>
</body>
</html>
