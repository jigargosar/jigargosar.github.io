---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPosts } from '../lib/posts'
import { SITE, AUTHOR } from '../config'

const posts = await getPosts()
const sortedPosts = posts.map(post => ({
  ...post,
  slug: post.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '')
}))

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.title,
  description: SITE.description,
  url: Astro.site?.href,
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
  },
}
---
<BaseLayout
  title={SITE.title}
  description={SITE.description}
  structuredData={structuredData}
>
  <div class="font-mono text-xs text-w18 uppercase mb-10" style="letter-spacing: 3px;">Posts</div>

  <ul class="list-none p-0">
    {sortedPosts.map(post => (
      <li class="group py-7 border-b border-w08 first:border-t first:border-w08">
        <div class="font-mono text-xs text-w30 mb-1.5" style="letter-spacing: 0.3px;">
          {post.data.date}
          {post.data.draft && import.meta.env.DEV && (
            <span class="ml-2 px-1.5 py-0.5 bg-w08 text-w30 rounded text-xs font-mono">
              draft
            </span>
          )}
        </div>
        <a
          href={`posts/${post.slug}/`}
          class="block font-sans font-semibold text-xl text-w90 no-underline group-hover:text-w75"
          style="letter-spacing: -0.3px; line-height: 1.35; transition: color 150ms ease;"
        >
          {post.data.title}
        </a>
        <p class="text-w45 mt-1.5" style="font-size: 15px; line-height: 1.6; max-width: 620px;">
          {post.data.intro}
        </p>
        {post.data.image && (
          <img
            src={post.data.image.src}
            alt={post.data.imageAlt || post.data.title}
            class="w-full mt-4 object-cover"
            style="aspect-ratio: 5/3; filter: grayscale(100%) brightness(0.55) contrast(1.1);"
            loading="lazy"
          />
        )}
      </li>
    ))}
  </ul>
</BaseLayout>
