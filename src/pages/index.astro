---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

function createSlugFromId(id: string) {
  const slugWithoutDate = id.replace(/^\d{4}-\d{2}-\d{2}-/, '')
  return slugWithoutDate.replace(/\.(md|mdx)$/, '')
}

const posts = await getCollection('posts')
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
---
<BaseLayout>
  <style>
    .underline-offset {
      text-underline-offset: 0.2em;
    }
    .decoration-thickness {
      text-decoration-thickness: 0.01em;
    }
  </style>

  <section id="posts" class="mt-8">
    <ul class="space-y-6">
      {sortedPosts.map(post => (
        <li>
          <a
            class="text-cyan-400 underline underline-offset decoration-thickness hover:text-cyan-300"
            href={`posts/${createSlugFromId(post.id)}/`}
          >
            {post.data.title}
          </a>
          <p class="text-gray-400 text-sm mt-1">
            {post.data.description}
          </p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
