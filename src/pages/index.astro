---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPosts } from '../lib/posts'
import { SITE, AUTHOR } from '../config'

const posts = await getPosts()
const sortedPosts = posts.map(post => ({
  ...post,
  slug: post.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '')
}))

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.title,
  description: SITE.description,
  url: Astro.site?.href,
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
  },
}
---
<BaseLayout
  title={SITE.title}
  description={SITE.description}
  structuredData={structuredData}
>
  <style>
    .underline-offset {
      text-underline-offset: 0.2em;
    }
    .decoration-thickness {
      text-decoration-thickness: 0.2em;
    }
  </style>

  <ul class="flex flex-col gap-10">
    {sortedPosts.map(post => (
      <li class="flex flex-col gap-5">
        <div class="flex items-center gap-3">
          <a
            class="text-cyan-400 text-2xl underline underline-offset decoration-thickness decoration-cyan-950 hover:decoration-cyan-700"
            href={`posts/${post.slug}/`}
          >
            {post.data.title}
          </a>
          {post.data.draft && import.meta.env.DEV && (
            <span class="px-2 py-1 bg-amber-400/20 border border-amber-400/50 rounded text-amber-300 text-xs font-medium">
              DRAFT
            </span>
          )}
        </div>
        <p class="text-gray-400 text-base">
          {post.data.intro}
        </p>
      </li>
    ))}
  </ul>

</BaseLayout>
