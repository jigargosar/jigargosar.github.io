---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPosts } from '../lib/posts'
import { SITE, AUTHOR } from '../config'

const posts = await getPosts()
const sortedPosts = posts.map(post => ({
  ...post,
  slug: post.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '')
}))

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.title,
  description: SITE.description,
  url: Astro.site?.href,
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
  },
}
---
<BaseLayout
  title={SITE.title}
  description={SITE.description}
  structuredData={structuredData}
>
  {/* List page hero image styles — disabled, restore when re-enabling the image block above
  <style>
    .post-hero {
      filter: grayscale(100%) brightness(0.55) contrast(1.1);
      transition: filter 150ms ease;
    }
    .group:hover .post-hero {
      filter: grayscale(100%) brightness(0.65) contrast(1.1);
    }
  </style>
  */}
  <ul class="list-none p-0">
    {sortedPosts.map(post => (
      <li class="group py-7">
        <div class="font-mono text-xs text-w30 mb-1.5" style="letter-spacing: 0.3px;">
          {post.data.date}{post.data.tag && ` · ${post.data.tag}`}
          {post.data.draft && import.meta.env.DEV && (
            <span class="ml-2 px-1.5 py-0.5 bg-w08 text-w30 rounded text-xs font-mono">
              draft
            </span>
          )}
        </div>
        <a
          href={`posts/${post.slug}/`}
          class="block font-sans font-semibold text-xl text-w90 no-underline group-hover:text-w75"
          style="letter-spacing: -0.3px; line-height: 1.35; transition: color 150ms ease;"
        >
          {post.data.title}
        </a>
        <p class="text-w45 mt-1.5" style="font-size: 15px; line-height: 1.6; max-width: 620px;">
          {post.data.intro}
        </p>
        {/* List page hero image — disabled, re-enable and pick an aspect-ratio to restore
          Styles (.post-hero hover) also commented out in <style> below.
          imagePosition per-post frontmatter controls object-position (e.g. '50% 38%')
        {post.data.image && (
          <img
            src={post.data.image.src}
            alt={post.data.imageAlt || post.data.title}
            class="post-hero w-full mt-4 object-cover"
            style={`aspect-ratio: 2/1; object-position: ${post.data.imagePosition ?? '50% 50%'};`}
            loading="lazy"
          />
        )}
        */}
      </li>
    ))}
  </ul>
</BaseLayout>
