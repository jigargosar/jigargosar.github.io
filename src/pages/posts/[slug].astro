---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
import { getPosts } from '../../lib/posts'
import { AUTHOR } from '../../config'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map(post => {
    const slug = post.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '')
    return {
      params: { slug },
      props: { post }
    }
  })
}


const { post } = Astro.props
const { Content } = await post.render()

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.intro,
  datePublished: post.data.date,
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
    url: Astro.site?.href,
  },
}
---
<BaseLayout
  title={`${post.data.title} - ${AUTHOR.name}`}
  description={post.data.intro}
  structuredData={structuredData}
>
  <style>
    @reference "../../styles/global.css";

    .post-content {
      --text-color: theme('colors.gray.400');

      @apply prose prose-invert max-w-none
             prose-a:text-cyan-400
             prose-headings:text-cyan-400
             prose-headings:font-bold
             prose-headings:mb-2
             prose-h1:text-cyan-300
             prose-h1:text-2xl
             prose-h2:text-xl
             prose-h2:mt-8
             prose-h3:text-base
             prose-h3:mt-6
             prose-p:text-[var(--text-color)]
             prose-p:leading-normal
             prose-p:mt-0
             prose-p:mb-4
             prose-p:last:mb-0
             prose-li:text-[var(--text-color)]
             prose-code:text-[var(--text-color)]
             prose-strong:text-[var(--text-color)]
             prose-em:text-[var(--text-color)];
    }
  </style>

  <div class="bg-white/[0.03] rounded-lg overflow-hidden">
    {post.data.image && (
      <div class="aspect-[5/3]">
        <Image
          src={post.data.image}
          alt={post.data.imageAlt || post.data.title}
          class="w-full h-full object-cover"
          widths={[800, 1200, 1600]}
          sizes="100vw"
        />
      </div>
    )}
    <div class="post-content px-6 py-8 border-t border-white/[0.05]">
      {post.data.draft && import.meta.env.DEV && (
        <div class="mb-4 px-3 py-2 bg-amber-400/20 border border-amber-400/50 rounded text-amber-300 text-sm font-medium">
          DRAFT - Not published in production
        </div>
      )}
      <h1>{post.data.title}</h1>
      <p>{post.data.intro}</p>
      <Content />
    </div>
  </div>
</BaseLayout>
