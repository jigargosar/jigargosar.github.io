---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
import { getPosts } from '../../lib/posts'
import { AUTHOR } from '../../config'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map(post => {
    const slug = post.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '')
    return {
      params: { slug },
      props: { post }
    }
  })
}

const { post } = Astro.props
const { Content, remarkPluginFrontmatter } = await post.render()
const minutesRead = remarkPluginFrontmatter.minutesRead

const formattedDate = new Date(post.data.date + 'T00:00:00').toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
})

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.intro,
  datePublished: post.data.date,
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
    url: Astro.site?.href,
  },
}
---
<BaseLayout
  title={`${post.data.title} - ${AUTHOR.name}`}
  description={post.data.intro}
  structuredData={structuredData}
>
  <style>
    @reference "../../styles/global.css";

    .post-content {
      max-width: 660px;
      margin: 0 auto;
      padding-bottom: 100px;
      font-size: 18px;
      font-weight: 200;
      line-height: 1.6;
      color: var(--color-w50);
    }

    .post-content :global(> p:first-of-type::first-letter) {
      font-family: var(--font-sans);
      font-size: 44px;
      float: left;
      line-height: 1;
      padding-right: 10px;
      padding-top: 4px;
      color: var(--color-w65);
      font-weight: 700;
    }

    .post-content :global(p) {
      margin: 0 0 1.5em;
    }

    .post-content :global(strong) {
      color: var(--color-w65);
      font-weight: 500;
    }

    /* Headings */
    .post-content :global(h2) {
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: 34px;
      color: var(--color-w65);
      letter-spacing: -0.3px;
      margin: 80px 0 24px;
      padding-top: 80px;
      border-top: 1px solid var(--color-w08);
      line-height: 1.3;
    }
    .post-content :global(h3) {
      font-family: var(--font-sans);
      font-weight: 500;
      font-size: 20px;
      color: var(--color-w65);
      margin: 56px 0 16px;
      line-height: 1.35;
    }

    /* Links */
    .post-content :global(a) {
      color: var(--color-w65);
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: var(--color-w30);
      transition: text-decoration-color 150ms ease;
    }
    .post-content :global(a:hover) {
      text-decoration-color: var(--color-w75);
    }

    /* Inline code */
    .post-content :global(code) {
      font-family: var(--font-mono);
      font-size: 0.88em;
      background: var(--color-bg-raised);
      border: 1px solid var(--color-border);
      padding: 2px 6px;
      border-radius: 3px;
      color: var(--color-w60);
    }
    .post-content :global(code::before),
    .post-content :global(code::after) {
      content: none;
    }

    /* Code blocks */
    .post-content :global(pre) {
      background: var(--color-bg-raised) !important;
      border: 1px solid var(--color-border);
      border-radius: 4px;
      padding: 24px;
      margin: 40px 0;
      overflow-x: auto;
    }
    .post-content :global(pre code) {
      background: none;
      border: none;
      padding: 0;
      font-size: 14px;
      line-height: 1.7;
      color: var(--color-w60);
      filter: saturate(0.35);
    }

    /* Blockquotes — self-contained context */
    .post-content :global(blockquote) {
      border-left: 2px solid var(--color-w18);
      padding-left: 20px;
      margin: 48px 0;
      font-style: italic;
      color: var(--color-w60);
    }
    .post-content :global(blockquote p) {
      font-size: 18px;
      line-height: 1.7;
    }
    .post-content :global(blockquote strong) {
      color: inherit;
      font-weight: 500;
    }
    .post-content :global(blockquote a) {
      color: inherit;
      text-decoration-color: var(--color-w18);
    }
    .post-content :global(blockquote li::marker) {
      color: var(--color-w30);
    }
    .post-content :global(blockquote code) {
      color: inherit;
    }

    /* Lists */
    .post-content :global(ul),
    .post-content :global(ol) {
      margin: 0 0 1.25em;
      padding-left: 1.5em;
    }
    .post-content :global(ul) {
      list-style: disc;
    }
    .post-content :global(ol) {
      list-style: decimal;
    }
    .post-content :global(li) {
      margin-bottom: 0.5em;
    }
    .post-content :global(li::marker) {
      color: var(--color-w30);
    }
    .post-content :global(li > p) {
      margin: 0;
    }

    /* Horizontal rule */
    .post-content :global(hr) {
      border: none;
      border-top: 1px solid var(--color-w18);
      margin: 48px 0;
    }

    /* Details/Summary */
    .post-content :global(details) {
      border: 1px solid var(--color-w18);
      border-radius: 4px;
      padding: 16px 20px;
      margin: 24px 0;
    }
    .post-content :global(summary) {
      cursor: pointer;
      font-family: var(--font-sans);
      font-weight: 500;
      color: var(--color-w60);
      font-size: 16px;
    }
    .post-content :global(details[open] summary) {
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--color-w08);
    }

    /* Images */
    .post-content :global(img) {
      max-width: 100%;
      height: auto;
    }

  </style>

  <article>
    <header class="pt-16 pb-0">
      {(post.data.tag || minutesRead) && (
        <div class="font-mono text-xs text-w30 mb-5 uppercase" style="letter-spacing: 3px;">
          {post.data.tag}{post.data.tag && minutesRead && ' · '}{minutesRead && `${minutesRead} min`}
        </div>
      )}
      <h1 class="font-sans font-bold text-w65" style="font-size: clamp(28px, 4.5vw, 44px); line-height: 1.15; letter-spacing: -0.5px; margin-bottom: 16px;">
        {post.data.title}
      </h1>
      <p class="text-w45 italic" style="font-size: 18px; line-height: 1.5; max-width: 560px; margin-bottom: 20px;">
        {post.data.intro}
      </p>
      <div class="font-mono text-xs text-w18 pb-8 border-b border-w08" style="letter-spacing: 0.3px;">
        {formattedDate} · {AUTHOR.name}
        {post.data.draft && import.meta.env.DEV && (
          <span class="ml-2 px-1.5 py-0.5 bg-w08 text-w30 rounded" style="letter-spacing: 0;">
            draft
          </span>
        )}
      </div>
    </header>

    {post.data.image && (
      <div class="my-10">
        <Image
          src={post.data.image}
          alt={post.data.imageAlt || post.data.title}
          class="w-full object-cover"
          style="aspect-ratio: 5/3; filter: grayscale(100%) brightness(0.7) contrast(1.05);"
          widths={[800, 1200, 1600]}
          sizes="100vw"
        />
      </div>
    )}

    <div class="post-content">
      <Content />
    </div>
  </article>
</BaseLayout>
