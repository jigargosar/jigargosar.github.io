---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
import { getPosts } from '../../lib/posts'
import { AUTHOR } from '../../config'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map(post => {
    const slug = post.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '')
    return {
      params: { slug },
      props: { post }
    }
  })
}

const { post } = Astro.props
const { Content, remarkPluginFrontmatter } = await post.render()
const minutesRead = remarkPluginFrontmatter.minutesRead

const formattedDate = new Date(post.data.date + 'T00:00:00').toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
})

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.intro,
  datePublished: post.data.date,
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
    url: Astro.site?.href,
  },
}
---
<BaseLayout
  title={`${post.data.title} - ${AUTHOR.name}`}
  description={post.data.intro}
  structuredData={structuredData}
>
  <style>
    @reference "../../styles/global.css";

    .post-content {
      @apply prose prose-invert;
      max-width: 660px;
      margin: 0 auto;
      padding-bottom: 100px;
    }

    .post-content :global(> p:first-of-type::first-letter) {
      font-family: var(--font-sans);
      font-size: 44px;
      float: left;
      line-height: 1;
      padding-right: 10px;
      padding-top: 4px;
      color: var(--color-w90);
      font-weight: 700;
    }

    /* Body text */
    .post-content :global(p) {
      margin-bottom: 22px;
    }
    .post-content :global(p),
    .post-content :global(li),
    .post-content :global(em),
    .post-content :global(strong) {
      color: var(--color-w60);
    }
    .post-content :global(strong) {
      color: var(--color-w75);
      font-weight: 600;
    }

    /* Headings */
    .post-content :global(h2) {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 22px;
      color: var(--color-w75);
      letter-spacing: -0.3px;
      margin-top: 56px;
      margin-bottom: 18px;
      padding-left: 16px;
      border-left: 2px solid var(--color-w18);
    }
    .post-content :global(h3) {
      font-family: var(--font-sans);
      font-weight: 500;
      font-size: 18px;
      color: var(--color-w60);
      margin-top: 40px;
      margin-bottom: 14px;
    }

    /* Links */
    .post-content :global(a) {
      color: var(--color-w75);
      text-decoration: none;
      border-bottom: 1px solid var(--color-w18);
      transition: color 150ms ease, border-bottom-color 150ms ease;
    }
    .post-content :global(a:hover) {
      color: var(--color-w90);
      border-bottom-color: var(--color-w30);
    }

    /* Code */
    .post-content :global(code) {
      font-family: var(--font-mono);
      font-size: 15px;
      font-weight: 300;
      background: var(--color-bg-raised);
      border: 1px solid var(--color-border);
      padding: 2px 7px;
      border-radius: 3px;
      color: var(--color-w75);
    }
    .post-content :global(code::before),
    .post-content :global(code::after) {
      content: none;
    }
    .post-content :global(pre) {
      background: var(--color-bg-raised) !important;
      border: 1px solid var(--color-border);
      border-radius: 4px;
      padding: 24px;
      margin: 28px 0;
    }
    .post-content :global(pre code) {
      background: none;
      border: none;
      padding: 0;
      color: var(--color-w60);
      font-size: 14px;
      line-height: 1.7;
      filter: saturate(0.35);
    }

    /* Lists — em-dash markers */
    .post-content :global(ul) {
      list-style: none;
      padding: 0;
      margin-bottom: 22px;
    }
    .post-content :global(ul li) {
      padding: 8px 0 8px 18px;
      position: relative;
      border-bottom: 1px solid var(--color-w08);
    }
    .post-content :global(ul li::before) {
      content: '—';
      position: absolute;
      left: 0;
      color: var(--color-w18);
      font-size: 14px;
    }
    .post-content :global(ul li strong) {
      font-family: var(--font-mono);
      color: var(--color-w75);
    }

    /* Blockquote / aside */
    .post-content :global(hr) {
      border: none;
      border-top: 1px solid var(--color-w08);
      margin: 40px 0;
    }

    .post-content :global(blockquote) {
      border-left: none;
      padding-left: 18px;
      margin: 32px 0;
      font-style: italic;
    }
    .post-content :global(blockquote p) {
      color: var(--color-w45);
      font-size: 16px;
      line-height: 1.7;
    }

  </style>

  <article>
    <header class="pt-16 pb-0">
      {(post.data.tag || minutesRead) && (
        <div class="font-mono text-xs text-w30 mb-5 uppercase" style="letter-spacing: 3px;">
          {post.data.tag}{post.data.tag && minutesRead && ' · '}{minutesRead && `${minutesRead} min`}
        </div>
      )}
      <h1 class="font-sans font-bold text-w90" style="font-size: clamp(28px, 4.5vw, 44px); line-height: 1.15; letter-spacing: -0.5px; margin-bottom: 16px;">
        {post.data.title}
      </h1>
      <p class="text-w45 font-light italic" style="font-size: 18px; line-height: 1.5; max-width: 560px; margin-bottom: 20px;">
        {post.data.intro}
      </p>
      <div class="font-mono text-xs text-w30 pb-8 border-b border-w08" style="letter-spacing: 0.3px;">
        {formattedDate} · {AUTHOR.name}
        {post.data.draft && import.meta.env.DEV && (
          <span class="ml-2 px-1.5 py-0.5 bg-w08 text-w30 rounded" style="letter-spacing: 0;">
            draft
          </span>
        )}
      </div>
    </header>

    {post.data.image && (
      <div class="my-10">
        <Image
          src={post.data.image}
          alt={post.data.imageAlt || post.data.title}
          class="w-full object-cover"
          style="aspect-ratio: 5/3; filter: grayscale(100%) brightness(0.7) contrast(1.05);"
          widths={[800, 1200, 1600]}
          sizes="100vw"
        />
      </div>
    )}

    <div class="post-content">
      <Content />
    </div>
  </article>
</BaseLayout>
