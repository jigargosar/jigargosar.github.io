---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts.map(post => {
    const slug = post.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '')
    return {
      params: { slug },
      props: { post }
    }
  })
}


const { post } = Astro.props
const { Content } = await post.render()
---
<BaseLayout>
  <style>
    @reference "../../styles/global.css";

    .post-content {
      --text-color: theme('colors.gray.400');

      @apply prose prose-invert max-w-none
             prose-a:text-cyan-400
             prose-headings:text-[var(--text-color)]
             prose-h1:text-2xl
             prose-h2:text-xl
             prose-h3:text-lg
             prose-p:text-[var(--text-color)]
             prose-p:leading-normal
             prose-p:last:mb-0
             prose-li:text-[var(--text-color)]
             prose-code:text-[var(--text-color)]
             prose-strong:text-[var(--text-color)]
             prose-em:text-[var(--text-color)];
    }
  </style>

  <div class="post-content">
    <h1>{post.data.title}</h1>
    <p>{post.data.intro}</p>
    <Content />
  </div>
</BaseLayout>
