---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
import { getPosts } from '../../lib/posts'
import { AUTHOR } from '../../config'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map(post => {
    const slug = post.slug.replace(/^\d{4}-\d{2}-\d{2}-/, '')
    return {
      params: { slug },
      props: { post }
    }
  })
}

const { post } = Astro.props
const { Content } = await post.render()

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.intro,
  datePublished: post.data.date,
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
    url: Astro.site?.href,
  },
}
---
<BaseLayout
  title={`${post.data.title} - ${AUTHOR.name}`}
  description={post.data.intro}
  structuredData={structuredData}
>
  <style>
    @reference "../../styles/global.css";

    .post-content {
      @apply prose prose-invert max-w-none;
    }

    /* Body text */
    .post-content :global(p),
    .post-content :global(li),
    .post-content :global(em),
    .post-content :global(strong) {
      color: rgba(255,255,255,0.58);
    }
    .post-content :global(strong) {
      color: rgba(255,255,255,0.72);
      font-weight: 600;
    }

    /* Headings */
    .post-content :global(h2) {
      font-family: 'Instrument Sans', -apple-system, sans-serif;
      font-weight: 600;
      font-size: 22px;
      color: rgba(255,255,255,0.72);
      letter-spacing: -0.3px;
      margin-top: 56px;
      margin-bottom: 18px;
      padding-left: 16px;
      border-left: 2px solid rgba(255,255,255,0.16);
    }
    .post-content :global(h3) {
      font-family: 'Instrument Sans', -apple-system, sans-serif;
      font-weight: 500;
      font-size: 18px;
      color: rgba(255,255,255,0.58);
      margin-top: 40px;
      margin-bottom: 14px;
    }

    /* Links */
    .post-content :global(a) {
      color: rgba(255,255,255,0.72);
      text-decoration: underline;
      text-decoration-color: rgba(255,255,255,0.16);
      text-underline-offset: 0.2em;
      text-decoration-thickness: 0.1em;
      transition: color 150ms ease, text-decoration-color 150ms ease;
    }
    .post-content :global(a:hover) {
      color: rgba(255,255,255,0.88);
      text-decoration-color: rgba(255,255,255,0.28);
    }

    /* Code */
    .post-content :global(code) {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 15px;
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.055);
      padding: 2px 7px;
      border-radius: 3px;
      color: rgba(255,255,255,0.72);
    }
    .post-content :global(pre) {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.055);
      border-radius: 4px;
      padding: 24px;
      margin: 28px 0;
    }
    .post-content :global(pre code) {
      background: none;
      border: none;
      padding: 0;
      color: rgba(255,255,255,0.58);
      font-size: 14px;
      line-height: 1.7;
    }

    /* Lists — em-dash markers */
    .post-content :global(ul) {
      list-style: none;
      padding: 0;
    }
    .post-content :global(ul li) {
      padding: 8px 0 8px 18px;
      position: relative;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    .post-content :global(ul li::before) {
      content: '—';
      position: absolute;
      left: 0;
      color: rgba(255,255,255,0.42);
      font-size: 14px;
    }

    /* Blockquote / aside */
    .post-content :global(blockquote) {
      border-left: 2px solid rgba(255,255,255,0.16);
      padding-left: 18px;
      margin: 32px 0;
      font-style: italic;
    }
    .post-content :global(blockquote p) {
      color: rgba(255,255,255,0.58);
      font-size: 16px;
      line-height: 1.7;
    }

    /* Drop cap */
    .post-content > :global(p:first-of-type::first-letter) {
      font-family: 'Instrument Sans', -apple-system, sans-serif;
      font-size: 52px;
      float: left;
      line-height: 1;
      padding-right: 10px;
      padding-top: 6px;
      color: rgba(255,255,255,0.88);
      font-weight: 700;
    }
  </style>

  <article>
    <header class="pt-16 pb-0">
      <div class="font-mono text-sm text-w60 mb-5 uppercase" style="letter-spacing: 3px;">
        {post.data.date}
        {post.data.draft && import.meta.env.DEV && (
          <span class="ml-2 px-1.5 py-0.5 bg-w08 text-w60 rounded normal-case" style="letter-spacing: 0;">
            draft
          </span>
        )}
      </div>
      <h1 class="font-sans font-bold text-w90" style="font-size: clamp(28px, 4.5vw, 44px); line-height: 1.15; letter-spacing: -0.5px; margin-bottom: 16px;">
        {post.data.title}
      </h1>
      <p class="text-w45 font-light italic" style="font-size: 18px; line-height: 1.5; max-width: 560px; margin-bottom: 20px;">
        {post.data.intro}
      </p>
      <div class="font-mono text-sm text-w60 pb-8 border-b border-w08" style="letter-spacing: 0.3px;">
        {AUTHOR.name}
      </div>
    </header>

    {post.data.image && (
      <div class="my-10">
        <Image
          src={post.data.image}
          alt={post.data.imageAlt || post.data.title}
          class="w-full object-cover"
          style="aspect-ratio: 5/3; filter: grayscale(100%) brightness(0.7) contrast(1.05);"
          widths={[800, 1200, 1600]}
          sizes="100vw"
        />
      </div>
    )}

    <div class="post-content max-w-[660px] mx-auto pb-24">
      <Content />
    </div>
  </article>
</BaseLayout>
