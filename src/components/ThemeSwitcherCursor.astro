---
// NOTE: Theme colors are duplicated from src/styles/accent-themes.css
// When adding/changing themes, update both locations.
// Ordered by hue angle for smooth color wheel progression
const themes = [
  { label: 'Lime', class: 'theme-lime', color: 'oklch(84.1% 0.238 128.85)' },    // 128.85°
  { label: 'Green', class: 'theme-green', color: 'oklch(79.2% 0.209 151.711)' }, // 151.71°
  { label: 'Emerald', class: 'theme-emerald', color: 'oklch(76.5% 0.177 163.223)' }, // 163.22°
  { label: 'Teal', class: 'theme-teal', color: 'oklch(77.7% 0.152 181.912)' },   // 181.91°
  { label: 'Cyan', class: 'theme-cyan', color: 'oklch(78.9% 0.154 211.53)' },    // 211.53°
  { label: 'Sky', class: 'theme-sky', color: 'oklch(74.6% 0.16 232.661)' },      // 232.66°
  { label: 'Blue', class: 'theme-blue', color: 'oklch(70.7% 0.165 254.624)' },   // 254.62°
  { label: 'Violet', class: 'theme-violet', color: 'oklch(70.2% 0.183 293.541)' }, // 293.54°
]
---

<div class="relative">
  <button
    id="theme-toggle-cursor"
    class="w-2 h-4 bg-accent-400 hover:ring-2 hover:ring-accent-400 hover:ring-offset-[3px] hover:ring-offset-gray-900 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-offset-[3px] focus:ring-offset-gray-900 cursor-blink"
    aria-label="Change theme"></button>
  <div
    id="theme-dropdown-cursor"
    class="hidden absolute right-1/2 translate-x-1/2 bottom-full mb-2 p-3 bg-gray-800 border border-gray-700 shadow-lg flex flex-col gap-3 items-center"
  >
    {
      themes.map((theme) => (
        <button
          data-theme-cursor={theme.class}
          class="w-2 h-4 hover:ring-2 hover:ring-accent-400 hover:ring-offset-[3px] hover:ring-offset-gray-800 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-offset-[3px] focus:ring-offset-gray-800"
          style={`background-color: ${theme.color};`}
          title={theme.label}
          aria-label={`Switch to ${theme.label}`}
        />
      ))
    }
  </div>
</div>

<style>
  .cursor-blink {
    animation: blink-cursor 1.5s infinite steps(2, start);
  }
  @keyframes blink-cursor {
    0%, 70% { opacity: 1; }
    80%, 100% { opacity: 0; }
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle-cursor')
  const dropdown = document.getElementById('theme-dropdown-cursor')
  const buttons = document.querySelectorAll('[data-theme-cursor]')

  const handleEscape = (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      dropdown?.classList.add('hidden')
      document.removeEventListener('keydown', handleEscape)
    }
  }

  toggle?.addEventListener('click', () => {
    const isHidden = dropdown?.classList.contains('hidden')
    dropdown?.classList.toggle('hidden')

    if (isHidden) {
      document.addEventListener('keydown', handleEscape)
    } else {
      document.removeEventListener('keydown', handleEscape)
    }
  })

  document.addEventListener('click', (e) => {
    if (
      !toggle?.contains(e.target as Node) &&
      !dropdown?.contains(e.target as Node)
    ) {
      dropdown?.classList.add('hidden')
      document.removeEventListener('keydown', handleEscape)
    }
  })

  // Get current theme from html element
  function getCurrentTheme() {
    const htmlClasses = document.documentElement.classList
    for (let i = 0; i < htmlClasses.length; i++) {
      if (htmlClasses[i].startsWith('theme-')) {
        return htmlClasses[i]
      }
    }
    return null
  }

  // Update active button ring
  function updateActiveRing() {
    const currentTheme = getCurrentTheme()
    buttons.forEach((b) => {
      if (b.dataset.themeCursor === currentTheme) {
        b.classList.add('ring-1', 'ring-white', 'ring-offset-[3px]', 'ring-offset-gray-800')
      } else {
        b.classList.remove('ring-1', 'ring-white', 'ring-offset-[3px]', 'ring-offset-gray-800')
      }
    })
  }

  // Update toggle button title to match current theme
  function updateToggleTitle() {
    const currentTheme = getCurrentTheme()
    const currentThemeData = [
      { label: 'Lime', class: 'theme-lime', color: 'oklch(84.1% 0.238 128.85)' },
      { label: 'Green', class: 'theme-green', color: 'oklch(79.2% 0.209 151.711)' },
      { label: 'Emerald', class: 'theme-emerald', color: 'oklch(76.5% 0.177 163.223)' },
      { label: 'Teal', class: 'theme-teal', color: 'oklch(77.7% 0.152 181.912)' },
      { label: 'Cyan', class: 'theme-cyan', color: 'oklch(78.9% 0.154 211.53)' },
      { label: 'Sky', class: 'theme-sky', color: 'oklch(74.6% 0.16 232.661)' },
      { label: 'Blue', class: 'theme-blue', color: 'oklch(70.7% 0.165 254.624)' },
      { label: 'Violet', class: 'theme-violet', color: 'oklch(70.2% 0.183 293.541)' },
    ].find(t => t.class === currentTheme)

    if (currentThemeData && toggle) {
      toggle.title = currentThemeData.label
    }
  }

  // Load theme from localStorage or use default
  function loadTheme() {
    const savedTheme = localStorage.getItem('theme')
    if (savedTheme) {
      // Remove any existing theme classes
      buttons.forEach((b) =>
        document.documentElement.classList.remove(b.dataset.themeCursor),
      )
      // Apply saved theme
      document.documentElement.classList.add(savedTheme)
    }
  }

  // Save theme to localStorage
  function saveTheme(theme: string) {
    localStorage.setItem('theme', theme)
  }

  // Initialize on load
  loadTheme()
  updateActiveRing()
  updateToggleTitle()

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const theme = btn.dataset.themeCursor
      buttons.forEach((b) =>
        document.documentElement.classList.remove(b.dataset.themeCursor),
      )
      document.documentElement.classList.add(theme)
      saveTheme(theme)
      updateActiveRing()
      updateToggleTitle()
    })
  })
</script>
