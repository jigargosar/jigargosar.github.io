---
interface Props {
  href: string
  variant?: 'default' | 'large'
}

const { href, variant = 'default', ...rest } = Astro.props

const variantStyles = {
  default: 'text-sm',
  large: 'text-xl font-semibold font-[Instrument_Sans]',
}

const baseStyles = 'text-w75 underline decoration-w18 hover:decoration-w30'
const variantClass = variantStyles[variant]
---

<a
  href={href}
  class={`${baseStyles} ${variantClass}`}
  style="text-underline-offset: 0.2em; text-decoration-thickness: 0.1em; transition: text-decoration-color 150ms ease;"
  {...rest}
>
  <slot />
</a>
