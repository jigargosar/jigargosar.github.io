---
import { THEMES } from '../config'
---

<div class="relative inline-flex">
  <button
    id="theme-toggle"
    class="w-6 h-6 rounded-full bg-accent-400 hover:ring-2 hover:ring-accent-400 hover:ring-offset-[3px] hover:ring-offset-gray-900 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-offset-[3px] focus:ring-offset-gray-900"
    aria-label="Change theme"></button>
  <div
    id="theme-dropdown"
    class="hidden absolute left-1/2 -translate-x-1/2 top-full mt-2 p-2 bg-gray-800 border border-gray-700 rounded-lg shadow-lg flex flex-col gap-3 items-center"
  >
    {
      THEMES.map((theme) => (
        <button
          data-theme={theme.class}
          class="w-6 h-6 rounded-full hover:ring-2 hover:ring-accent-400 hover:ring-offset-[3px] hover:ring-offset-gray-800 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-offset-[3px] focus:ring-offset-gray-800"
          style={`background-color: ${theme.color};`}
          title={theme.label}
          aria-label={`Switch to ${theme.label}`}
        />
      ))
    }
  </div>
</div>

<script>
  import { THEMES, DEFAULT_THEME } from '../config'

  const themes = THEMES
  const defaultTheme = DEFAULT_THEME
  const toggle = document.getElementById('theme-toggle')
  const dropdown = document.getElementById('theme-dropdown')
  const buttons = document.querySelectorAll('[data-theme]')

  const handleEscape = (e) => {
    if (e.key === 'Escape') {
      dropdown?.classList.add('hidden')
      document.removeEventListener('keydown', handleEscape)
    }
  }

  toggle?.addEventListener('click', () => {
    const isHidden = dropdown?.classList.contains('hidden')
    dropdown?.classList.toggle('hidden')

    if (isHidden) {
      document.addEventListener('keydown', handleEscape)
    } else {
      document.removeEventListener('keydown', handleEscape)
    }
  })

  document.addEventListener('click', (e) => {
    if (
      !toggle?.contains(e.target) &&
      !dropdown?.contains(e.target)
    ) {
      dropdown?.classList.add('hidden')
      document.removeEventListener('keydown', handleEscape)
    }
  })

  // Get current theme from html element
  function getCurrentTheme() {
    const htmlClasses = document.documentElement.classList
    for (let i = 0; i < htmlClasses.length; i++) {
      if (htmlClasses[i].startsWith('theme-')) {
        return htmlClasses[i]
      }
    }
    return null
  }

  // Update active button ring
  function updateActiveRing() {
    const currentTheme = getCurrentTheme()
    buttons.forEach((b) => {
      if (b.dataset.theme === currentTheme) {
        b.classList.add('ring-1', 'ring-white', 'ring-offset-[3px]', 'ring-offset-gray-800')
      } else {
        b.classList.remove('ring-1', 'ring-white', 'ring-offset-[3px]', 'ring-offset-gray-800')
      }
    })
  }

  // Update toggle button title to match current theme
  function updateToggleTitle() {
    const currentTheme = getCurrentTheme()
    const currentThemeData = themes.find(t => t.class === currentTheme)

    if (currentThemeData && toggle) {
      toggle.title = currentThemeData.label
    }
  }

  // Load theme from localStorage or use default
  function loadTheme() {
    const savedTheme = localStorage.getItem('theme')
    // Validate that saved theme exists in current themes list
    const isValidTheme = savedTheme && themes.some(t => t.class === savedTheme)
    const themeToApply = isValidTheme ? savedTheme : defaultTheme

    // Remove any existing theme classes
    buttons.forEach((b) =>
      document.documentElement.classList.remove(b.dataset.theme),
    )
    // Apply theme
    document.documentElement.classList.add(themeToApply)
  }

  // Save theme to localStorage
  function saveTheme(theme) {
    localStorage.setItem('theme', theme)
  }

  // Initialize on load
  loadTheme()
  updateActiveRing()
  updateToggleTitle()

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const theme = btn.dataset.theme
      buttons.forEach((b) =>
        document.documentElement.classList.remove(b.dataset.theme),
      )
      document.documentElement.classList.add(theme)
      saveTheme(theme)
      updateActiveRing()
      updateToggleTitle()
    })
  })
</script>
